---
import type {CollectionEntry} from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import {url} from '../lib/paths';
import Icon from '../components/Icon.astro';
import ProjectDocuments from '../components/ProjectDocuments.astro';
interface Props{project:CollectionEntry<'projects'>;headings:{depth:number;slug:string;text:string}[];}
const {project,headings}=Astro.props;const p=project.data;
---
<BaseLayout title={p.title} description={p.summary}>
<article class="case-study wrap" data-project={project.id} data-media-kind={p.mediaKind}>
<a class="back-link" href={url('/projects/')}>← all projects</a>
<header class="case-header">
<p class="eyebrow">{p.category}{p.year&&` / ${p.year}`}</p>
<h1>{p.title}</h1>
<p>{p.subtitle}</p>
</header>
<div class="case-cover">
<img src={url(p.cover)} alt={p.coverAlt} width="1200" height="750" fetchpriority="high"/>
<span class="art-caption">{{concept:'concept illustration',diagram:'functional diagram',photo:'project photograph',cad:'project CAD',platform:'Mini Pupper platform'}[p.mediaKind]}</span>
</div>
<dl class="project-facts">
{p.projectStatus&&<div><dt>Status</dt><dd>{p.projectStatus}</dd></div>}
{p.teamContext&&<div><dt>Team context</dt><dd>{p.teamContext}</dd></div>}{p.role&&<div>
<dt>Role</dt>
<dd>{p.role}</dd>
</div>}{p.year&&<div>
<dt>Year</dt>
<dd>{p.year}</dd>
</div>}<div>
<dt>Discipline</dt>
<dd>{p.category}</dd>
</div>
{p.tools.length>0&&<div><dt>Tools & technologies</dt><dd>{p.tools.join(' · ')}</dd></div>}
</dl>
 <div class="case-body">
<aside class="case-nav">
<p class="eyebrow">in this project</p>
<nav aria-label="Case study sections">{headings.filter(h=>h.depth===2).map(h=>
<a href={`#${h.slug}`}>{h.text}</a>)}{p.documents.length>0&&<a href="#report-poster">Report &amp; poster</a>}</nav>
</aside>
<div class="prose">
<slot/>{p.documents.length>0&&<ProjectDocuments ids={p.documents}/>}
{p.gallery.length>0&&<section class="case-gallery" aria-label="Project gallery">{p.gallery.map(img=>
<figure>
<img src={url(img.src)} alt={img.alt} width="1000" height="650" loading="lazy"/>{img.caption&&<figcaption>{img.caption}</figcaption>}</figure>)}</section>}{p.links.length>0&&<div class="actions">{p.links.map(link=>
<a class="button secondary" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Icon/>
</a>)}</div>}</div>
</div>
<div class="case-bottom">
<p>More intersections to explore.</p>
<a class="button secondary" href={url('/projects/')}>back to projects <Icon name="right"/>
</a>
</div>
</article>
</BaseLayout>
