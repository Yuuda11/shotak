---
import type {CollectionEntry} from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import {url} from '../lib/paths';
import Icon from '../components/Icon.astro';
import ProjectDocuments from '../components/ProjectDocuments.astro';
import RocketSystemsOverview from '../components/RocketSystemsOverview.astro';
import RocketControlArchitecture from '../components/RocketControlArchitecture.astro';
import RocketTimeline from '../components/RocketTimeline.astro';
import RocketFlightResults from '../components/RocketFlightResults.astro';
import RocketRecognition from '../components/RocketRecognition.astro';
import RocketProjectIntro from '../components/RocketProjectIntro.astro';
import RocketActuationComparison from '../components/RocketActuationComparison.astro';
import RocketSimulation from '../components/RocketSimulation.astro';
interface Props{project:CollectionEntry<'projects'>;headings:{depth:number;slug:string;text:string}[];}
const {project,headings}=Astro.props;const p=project.data;
const projectTitle=p.title.replace(/\.$/,'');
const projectTitleSplit=projectTitle.lastIndexOf(' ');
const projectTitlePrefix=projectTitleSplit>=0?projectTitle.slice(0,projectTitleSplit+1):'';
const projectTitleFinal=projectTitle.slice(projectTitleSplit+1);
const subtitleHighlightIndex=p.highlightPhrase?p.subtitle.indexOf(p.highlightPhrase):-1;
---
<BaseLayout title={p.title} description={p.summary}>
<article class="case-study wrap" data-project={project.id} data-media-kind={p.mediaKind}>
<a class="back-link" href={url('/projects/')}>← all projects</a>
<header class="case-header">
<p class="eyebrow">{p.category}{p.year&&` / ${p.year}`}</p>
<h1>{projectTitlePrefix}<span class="project-title-final">{projectTitleFinal}<span class="project-title-dot">.</span></span></h1>
<p>{subtitleHighlightIndex>=0&&p.highlightPhrase?<>{p.subtitle.slice(0,subtitleHighlightIndex)}<span class={`project-subtitle-highlight tone-${p.highlightTone??'blue'}`}>{p.highlightPhrase}</span>{p.subtitle.slice(subtitleHighlightIndex+p.highlightPhrase.length)}</>:p.subtitle}</p>
</header>
<div class="case-cover">
<img src={url(p.cover)} alt={p.coverAlt} width="1200" height="750" fetchpriority="high"/>
<span class="art-caption">{{concept:'concept illustration',diagram:'functional diagram',photo:'project photograph',cad:'project CAD',platform:'Mini Pupper platform'}[p.mediaKind]}{project.id==='rocket-airbrake'&&<> · <a href={url(p.cover)} target="_blank" rel="noopener noreferrer">open CAD image</a></>}</span>
</div>
{project.id==='rocket-airbrake'&&<RocketProjectIntro/>}
{project.id!=='rocket-airbrake'&&<dl class="project-facts">
{p.projectStatus&&<div><dt>Status</dt><dd>{p.projectStatus}</dd></div>}
{p.teamContext&&<div><dt>Team context</dt><dd>{p.teamContext}</dd></div>}{p.role&&<div>
<dt>Role</dt>
<dd>{p.role}</dd>
</div>}{p.year&&<div>
<dt>Year</dt>
<dd>{p.year}</dd>
</div>}<div>
<dt>Discipline</dt>
<dd>{p.category}</dd>
</div>
{p.tools.length>0&&<div><dt>Tools & technologies</dt><dd>{p.tools.join(' · ')}</dd></div>}
</dl>}
 <div class="case-body">
<aside class="case-nav">
<nav aria-label="In this project">
<p class="eyebrow">in this project</p>
{project.id==='rocket-airbrake'?<>
<a href="#engineering-systems">Engineering systems</a><a href="#control-architecture">My contribution</a><a href="#actuation">Actuation demo</a><a href="#simulation">Simulation</a><a href="#development-timeline">Development timeline</a><a href="#flight-results">Test results</a><a href="#recognition">Recognition</a><a href="#lessons-learned">Lessons learned</a><a href="#report-poster">Technical evidence</a>
</>:<>{headings.filter(h=>h.depth===2).map(h=>
<a href={`#${h.slug}`}>{h.text}</a>)}{p.documents.length>0&&<a href="#report-poster">Technical evidence · report &amp; poster</a>}</>}
</nav>
</aside>
<div class="prose">
{project.id==='rocket-airbrake'&&<>
<RocketSystemsOverview/><RocketControlArchitecture/><RocketActuationComparison/><RocketSimulation/><RocketTimeline/><RocketFlightResults/><RocketRecognition/>
</>}
{project.id==='rocket-airbrake'?<>
{p.documents.length>0&&<ProjectDocuments ids={p.documents}/>}
<slot/>
</>:<>
<slot/>{p.documents.length>0&&<ProjectDocuments ids={p.documents}/>}
{p.gallery.length>0&&<section class="case-gallery" aria-label="Project gallery">{p.gallery.map(img=>
<figure>
<img src={url(img.src)} alt={img.alt} width="1000" height="650" loading="lazy"/>{img.caption&&<figcaption>{img.caption}</figcaption>}</figure>)}</section>}{p.links.length>0&&<div class="actions">{p.links.map(link=>
<a class="button secondary" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<Icon/>
</a>)}</div>}
</>}
</div>
</div>
<div class="case-bottom">
<p>More intersections to explore.</p>
<a class="button secondary" href={url('/projects/')}>back to projects <Icon name="right"/>
</a>
</div>
</article>
</BaseLayout>
