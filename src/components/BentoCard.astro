---
import Icon from './Icon.astro';
interface Props {href?:string;class?:string;label?:string;}
const {href,class:className='',label}=Astro.props;const Tag=href?'a':'div';
---
<Tag href={href} class:list={['bento-card',className]} data-reveal>{label&&<p class="eyebrow">{label}</p>}<slot/>{href&&<span class="card-arrow">
<Icon/>
</span>}</Tag>
