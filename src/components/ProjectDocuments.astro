---
import {projectDocuments,type ProjectDocumentId} from '../data/documents';
import {url} from '../lib/paths';
import Icon from './Icon.astro';
interface Props {ids:ProjectDocumentId[];}
const {ids}=Astro.props;
---
<section class="project-documents" id="report-poster" aria-labelledby="documents-heading">
  <h2 id="documents-heading">Technical evidence</h2>
  <p>The original team final report and research poster, preserved intact. The report contains the detailed test history and flight limitations.</p>
  <div class="document-links">{ids.map(id=>{
    const doc=projectDocuments[id];
    return <a href={url(`/documents/${id}/`)}><span>{doc.action}</span><small>{doc.pages} {doc.pages===1?'page':'pages'} · PDF preview</small><Icon name="arrow"/></a>;
  })}</div>
  {ids.includes('rocket-poster')&&<figure class="poster-preview"><a href={url('/documents/rocket-poster/')} aria-label="Inspect the complete research poster"><img src={url(projectDocuments['rocket-poster'].preview)} alt="Team research poster presenting the rocket’s design, avionics, and flight results" width="2400" height="1800" loading="lazy"/></a><figcaption>Research poster. Open its preview or full PDF to inspect the details.</figcaption></figure>}
</section>
