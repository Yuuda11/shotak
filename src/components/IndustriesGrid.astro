---
import {industries} from '../data/profile';
import {url} from '../lib/paths';
---
<section id="industries" class="section industries-section" aria-labelledby="industries-heading">
  <div class="section-heading" data-reveal>
    <p class="eyebrow">06 / applications &amp; industries</p>
    <h2 id="industries-heading">engineering across industries.</h2>
  </div>
  <div class="industries-grid">
    {industries.map(industry => <a class="industry-row" href={url(industry.href)} data-reveal>
      <p class="industry-kind">{industry.kind}</p>
      <h3>{industry.title}</h3>
      <p>{industry.detail}</p>
    </a>)}
  </div>
</section>
