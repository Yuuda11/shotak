---
import {url} from '../lib/paths';
import {aboutSections} from '../data/aboutSections';
import ProcessTimeline from './ProcessTimeline.astro';
const number = aboutSections.find(section=>section.id==='research-development')?.number;
const steps = [
  {title:'Explore',text:'Identify problems, review existing approaches, and develop hypotheses.',tone:'blue' as const},
  {title:'Design',text:'Develop analytical models, simulations, and engineering concepts.',tone:'sage' as const},
  {title:'Build',text:'Create prototypes, integrate hardware, and implement solutions.',tone:'lavender' as const},
  {title:'Analyze',text:'Collect data, investigate performance, and identify root causes.',tone:'cream' as const},
  {title:'Validate',text:'Test improvements, assess reliability, and document results.',tone:'blue' as const},
];
---
<section id="research-development" class="section research-development" aria-labelledby="research-heading">
  <div class="section-heading" data-reveal>
    <p class="eyebrow">{number} / research &amp; development</p>
    <h2 id="research-heading">from hypothesis to <span class="marker-highlight marker-lavender">hardware.</span></h2>
    <p class="section-description">My approach to engineering combines curiosity, experimentation, and practical implementation. I enjoy investigating how physical systems behave, testing ideas through simulation and experimentation, and translating findings into reliable engineering solutions.</p>
  </div>
  <ProcessTimeline className="research-process" steps={steps.map((step) => ({ title: step.title, detail: step.text, tone: step.tone }))} label="Five stages of engineering research and development" />
  <div class="research-examples" aria-label="Examples across experience and projects">
    <p class="research-examples-label">ACROSS EXPERIENCE &amp; PROJECTS</p>
    <ul>
      <li><a href={url('/about/#experience')}>Apple</a><span>Optical metrology, calibration, and experimental validation.</span></li>
      <li><a href={url('/about/#experience')}>GW Research</a><span>Fluid dynamics, experimental data analysis, and computational methods.</span></li>
      <li><a href={url('/projects/undergraduate-research-fluid-mechanics/')}>Fluid Mechanics Research</a><span>Rheometry, scientific computing, and concentration-dependent modeling.</span></li>
      <li><a href={url('/projects/embedded-iot/')}>Environmental Chamber</a><span>Separate prototype project developed during the Undergraduate Research Fellowship.</span></li>
      <li><a href={url('/projects/rocket-airbrake/')}>Rocket Capstone</a><span>Embedded systems, flight simulation, hardware integration, and testing.</span></li>
      <li><a href={url('/about/#experience')}>Medtronic</a><span>Manufacturing experimentation and process improvement.</span></li>
    </ul>
  </div>
</section>
