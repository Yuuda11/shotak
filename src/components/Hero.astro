---
import {url} from '../lib/paths';
import Icon from './Icon.astro';
import AnimatedPageTitle from './AnimatedPageTitle.astro';
---
<section class="hero wrap" aria-labelledby="intro-heading">
  <div class="hero-columns">
    <div class="hero-title">
      <AnimatedPageTitle id="intro-heading" lines={['shota kakiuchi']} variant="hero" subtitle="mechanical & hardware engineer" subtitleHighlight="hardware engineer"/>
      <div class="actions">
        <a class="hero-work-link" href={url('/#work')}>explore my work <Icon name="arrow"/></a>
        <a class="text-link" href={url('/about/')}>about me</a>
      </div>
    </div>
    <section class="philosophy" aria-labelledby="philosophy-heading">
      <h2 id="philosophy-heading">my philosophy</h2>
      <p>turning complex engineering problems into simple, reliable, and impactful solutions — from idea to implementation.</p>
      <ul class="philosophy-tags" aria-label="Engineering focus">
        <li>hardware</li><li>manufacturing</li><li>systems</li>
      </ul>
    </section>
  </div>
</section>
