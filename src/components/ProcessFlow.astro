---
interface Step {
  number?: string;
  title: string;
  detail?: string;
  tone?: 'blue' | 'sage' | 'lavender' | 'cream';
}

interface Props {
  steps: Step[];
  label: string;
  columns?: number;
  className?: string;
}

const { steps, label, columns = 2, className } = Astro.props;
---

<ol
  class:list={['process-flow', className]}
  style={`--process-columns:${columns}`}
  aria-label={label}
>
  {steps.map((step, index) => (
    <li class:list={['process-flow-step', step.tone && `tone-${step.tone}`]}>
      <span class="process-flow-number">{step.number ?? String(index + 1).padStart(2, '0')}</span>
      <strong>{step.title}</strong>
      {step.detail && <p>{step.detail}</p>}
    </li>
  ))}
</ol>

<style>
  .process-flow {
    display: grid;
    grid-template-columns: repeat(var(--process-columns, 2), minmax(0, 1fr));
    align-items: stretch;
    gap: 12px;
    min-width: 0;
    margin: var(--process-intro-gap, 48px) 0 0;
    padding: 0;
    list-style: none;
  }
  .process-flow.process-heading-following { margin-top: var(--process-heading-gap, 60px); }
  .process-flow-step {
    display: grid;
    grid-template-rows: auto auto 1fr;
    align-content: start;
    align-items: start;
    gap: 7px;
    min-width: 0;
    margin: 0;
    padding: 12px 13px 13px;
    border-top: 2px solid #cbd5d0;
    background: linear-gradient(180deg, #f3f5f3 0%, transparent 100%);
  }
  .process-flow-step.tone-blue { border-top-color: #c1d2e2; background: linear-gradient(180deg, #e7f0fa8c, transparent 100%); }
  .process-flow-step.tone-sage { border-top-color: #c5d3c3; background: linear-gradient(180deg, #e7eee78c, transparent 100%); }
  .process-flow-step.tone-lavender { border-top-color: #d3c9dc; background: linear-gradient(180deg, #f1edf58c, transparent 100%); }
  .process-flow-step.tone-cream { border-top-color: #d9cbb8; background: linear-gradient(180deg, #f5eee38c, transparent 100%); }
  .process-flow-number {
    color: #73879a;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: .08em;
    font-variant-numeric: tabular-nums;
  }
  .process-flow .process-flow-step > strong {
    display: block;
    min-width: 0;
    color: #323a34;
    font-size: 12px;
    font-weight: 550;
    line-height: 1.4;
    overflow-wrap: normal;
    word-break: normal;
  }
  .process-flow-step p {
    min-width: 0;
    margin: 0;
    color: #61675f;
    font-size: 11px;
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .process-flow { grid-template-columns: minmax(0, 1fr); gap: 9px; }
  }
</style>
