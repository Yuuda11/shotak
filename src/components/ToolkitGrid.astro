---
import {toolkitCategories,skillsForReview,skillsVerificationNotes} from '../data/profile';
import {aboutSections} from '../data/aboutSections';
const number = aboutSections.find(section=>section.id==='toolkit')?.number;
---
<section id="toolkit" class="section toolkit-section" aria-labelledby="toolkit-heading">
  <div class="section-heading" data-reveal>
    <p class="eyebrow">{number} / technical toolkit</p>
    <h2 id="toolkit-heading">the tools behind the work.</h2>
  </div>
  <dl class="toolkit-grid">
    {toolkitCategories.map(category => <div class="toolkit-row" data-reveal><dt>{category.name}</dt><dd><div class="tags">{category.items.map(item => <span>{item}</span>)}</div></dd></div>)}
  </dl>
  <aside class="skill-review" aria-labelledby="skill-review-heading" data-reveal>
    <h3 id="skill-review-heading">Skills to confirm before public claims</h3>
    <p>Machine learning needs a specific project, application, or coursework example. AWS remains unnamed until its service or work context is confirmed.</p>
    <div class="tags">{skillsForReview.map(skill => <span>{skill}</span>)}</div>
    <ul class="skill-verification-notes">{skillsVerificationNotes.filter(note=>!note.startsWith('Machine learning')).map(note=><li>{note}</li>)}</ul>
  </aside>
</section>
