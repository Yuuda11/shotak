---
import TechnicalFigure from './TechnicalFigure.astro';
const disciplines = [
  ['Avionics', 'M6 6h12v12H6z M9 2v4m6-4v4M9 18v4m6-4v4M2 9h4m-4 6h4m12-6h4m-4 6h4'],
  ['Rocket Design', 'M8 15C9 8 14 4 21 3c-1 7-5 12-12 13z M8 11l-4 1-2 5 6-2m5 1-1 5 5-3 1-5M5 18l-2 3'],
  ['Propellant Manufacturing', 'M12 2c2 6-4 8-2 12 2-1 4-3 4-6 6 5 7 13-1 14C5 22 3 15 7 10c0 3 1 4 2 4-2-6 4-7 3-12z'],
  ['Electronics', 'M3 3h18v18H3z M6 16h5v-5h7 M6 7h4'],
  ['Flight Controller', 'M3 6h18M3 12h18M3 18h18M8 4v4m8 2v4m-7 2v4'],
  ['Recovery', 'M2 12a10 10 0 0 1 20 0H2zm0 0 10 9 10-9m-15 0 5 9 5-9'],
  ['Simulation', 'M3 3v17h18M6 15l4-6 4 3 6-8'],
  ['CAD', 'm12 2 9 5v10l-9 5-9-5V7zM3 7l9 5 9-5m-9 5v10'],
];
---
<section id="real-vehicle" class="goal" aria-labelledby="goal-heading">
  <div>
    <p class="eyebrow">THE GOAL</p>
    <h2 id="goal-heading">Build a rocket that can control how high it flies.</h2>
    <p class="eyebrow">THE APPROACH</p>
    <p class="approach">Adjust aerodynamic drag using deployable airbrakes to control the rocket's peak altitude.</p>
  </div>
  <TechnicalFigure src="/images/projects/rocket-airbrake/assembly.webp" alt="CAD assembly of the rocket’s deployable airbrake mechanism" caption="Airbrake assembly · project CAD" width={537} height={481}/>
</section>
<section id="engineering-systems" aria-labelledby="team-scope">
  <h2 class="eyebrow" id="team-scope">Team engineering systems</h2>
  <ul>{disciplines.map(([label,path]) => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d={path}/></svg>{label}</li>)}</ul>
  <dl>
    <div><dt>Rocket length</dt><dd>11.12 ft</dd></div>
    <div><dt>Lower observed apogee</dt><dd>4.6%</dd></div>
    <div><dt>Team members</dt><dd>4</dd></div>
  </dl>
  <p class="note">The full-deployment flight peaked 4.6% below the baseline flight. Predictive altitude targeting was evaluated in simulation only.</p>
</section>
<style>
  section {padding-block:var(--section-space);border-top:1px solid var(--border)}
  .goal {display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:clamp(24px,6vw,84px)}
  .goal h2 {font-size:clamp(2rem,4vw,3.75rem);max-width:19ch;margin-bottom:30px}
  .eyebrow {margin-bottom:12px}
  .approach {max-width:43ch;font-size:clamp(1rem,1.6vw,1.25rem)}
  ul,dl {display:grid;gap:24px;list-style:none;padding:0}
  ul {grid-template-columns:repeat(4,1fr);margin:24px 0 32px}
  li {display:grid;align-content:start;gap:8px}
  svg {width:24px;height:24px;fill:none;stroke:var(--muted);stroke-width:1.5;stroke-linejoin:round;stroke-linecap:round}
  dl {grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border);padding-top:24px}
  dl div {display:flex;flex-direction:column-reverse;justify-content:end}
  dd {margin:0;font-size:clamp(1.65rem,4vw,3.25rem);letter-spacing:-.05em}
  dt,.note {color:var(--muted);font-size:.875rem}
  .note {margin-top:20px}
  @media(max-width:660px){.goal {grid-template-columns:1fr}ul {grid-template-columns:repeat(2,1fr)}dl {gap:12px}}
</style>
