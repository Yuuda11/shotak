---
import TechnicalFigure from './TechnicalFigure.astro';
---
<section id="real-vehicle" class="section" aria-labelledby="goal-heading">
  <div class="goal">
  <div class="section-heading">
    <p class="eyebrow">THE GOAL</p>
    <h2 id="goal-heading">control how high a rocket flies.</h2>
    <p class="eyebrow">THE APPROACH</p>
    <p class="approach">Control aerodynamic drag using deployable airbrakes.</p>
  </div>
  <TechnicalFigure src="/images/projects/rocket-airbrake/assembly.webp" alt="CAD assembly of the rocket’s deployable airbrake mechanism" caption="Airbrake assembly · project CAD" width={537} height={481}/>
  </div>
  <dl>
    <div><dt>Rocket length</dt><dd>11.12 <small>ft</small></dd></div>
    <div><dt>Lower apogee with airbrakes deployed</dt><dd>4.6%</dd></div>
    <div><dt>Team members</dt><dd>4</dd></div>
  </dl>
</section>
<style>
  section {border-top:1px solid var(--border)}
  .goal {display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:var(--process-intro-gap)}
  .section-heading {margin:0}
  h2 {max-width:19ch;margin-bottom:var(--related-content-gap)}
  .approach {max-width:36ch}
  dl {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;border-top:1px solid var(--border);margin-top:var(--related-content-gap);padding-top:24px}
  dl div {display:flex;flex-direction:column-reverse;justify-content:end}
  dd {margin:0;font-size:clamp(1.65rem,4vw,3.25rem);letter-spacing:-.05em}
  dd small {font-size:.5em}
  dt {color:var(--muted);font-size:.875rem}
  @media(max-width:660px){.goal {grid-template-columns:1fr}dl {gap:10px}}
</style>
