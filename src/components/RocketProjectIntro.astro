---
import {url} from '../lib/paths';
import TechnicalFigure from './TechnicalFigure.astro';
---
<section class="rocket-introduction" id="real-vehicle" aria-label="The rocket and project team">
  <TechnicalFigure src="/images/projects/rocket-airbrake/media/rocket-team-launchpad.webp" alt="Four-person project team beside the assembled rocket at the launch pad; the rocket extends beyond the top edge of the photograph." caption="Four-person capstone team · launch pad" width={781} height={1004} className="rocket-introduction-photo"/>
  <div class="rocket-introduction-copy">
    <p class="eyebrow">THE REAL VEHICLE</p>
    <div class="rocket-intro-identity">
      <h2>from design to <span class="rocket-intro-highlight">flight.</span></h2>
      <p>High-powered altitude-targeting rocket</p>
    </div>

    <dl class="rocket-intro-scale" aria-label="Project scale">
      <div><dt>Team members</dt><dd>4</dd></div>
      <div><dt>Rocket length</dt><dd>11.12 <small>ft</small></dd></div>
    </dl>

    <div class="rocket-intro-contribution">
      <p class="rocket-intro-label">MY CONTRIBUTION</p>
      <ul>
        <li>
          <span class="rocket-intro-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4m6-4v4M9 18v4m6-4v4M2 9h4m-4 6h4m12-6h4m-4 6h4M9 10h6v4H9z"/></svg></span>
          <span class="rocket-intro-item-title">Electronics</span>
          <span class="rocket-intro-item-detail">Avionics &amp; sensors</span>
        </li>
        <li>
          <span class="rocket-intro-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8h3v3H8zM14 8h2m-2 3h2M8 14h2m2 0h4m-8 3h8M2 8h2m-2 4h2m16-4h2m-2 4h2M8 2v2m4-2v2m4-2v2M8 20v2m4-2v2m4-2v2"/></svg></span>
          <span class="rocket-intro-item-title">PCB Design</span>
          <span class="rocket-intro-item-detail">Custom flight computer</span>
        </li>
        <li>
          <span class="rocket-intro-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 14"/></svg></span>
          <span class="rocket-intro-item-title">Software</span>
          <span class="rocket-intro-item-detail">Embedded controls &amp; architecture</span>
        </li>
      </ul>
    </div>

    <a class="rocket-intro-award" href={url('/about/#honors-senior-design')}>
      <span class="rocket-intro-award-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4"/><path d="m12 6 .8 1.6 1.8.3-1.3 1.2.3 1.8-1.6-.8-1.6.8.3-1.8-1.3-1.2 1.8-.3z"/></svg></span>
      <span class="rocket-intro-award-copy"><strong>Best Senior Design Project</strong><small>Team award · GW Mechanical &amp; Aerospace Engineering · 2026</small></span>
      <span class="rocket-intro-award-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
  <TechnicalFigure src="/images/projects/rocket-airbrake/media/rocket-in-flight.webp" alt="Rocket ascending under motor thrust against a blue sky." caption="Rocket during powered ascent." width={174} height={662} className="rocket-introduction-flight"/>
</section>
