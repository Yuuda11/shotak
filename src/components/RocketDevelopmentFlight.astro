---
import TechnicalFigure from './TechnicalFigure.astro';
import {url} from '../lib/paths';

const milestones = [
  {date:'August 2025', title:'Design', text:'Requirements, system concept, and initial CAD.', tone:'blue'},
  {date:'Fall / Winter 2025–26', title:'Engineering & Manufacturing', text:'Team CAD, CFD / FEA, manufacturing, propulsion, electronics, avionics, and PCB integration.', tone:'sage'},
  {date:'February 28, 2026', title:'First Flight', text:'Recovery failure damaged the vehicle; airbrake deployment was disabled for data collection.', tone:'coral'},
  {date:'March 2026', title:'Rebuild & Refine', text:'Recovery revisions, hardware integration, software, and simulation work.', tone:'lavender'},
  {date:'April 11, 2026', title:'Baseline Flight', text:'5,867 ft; airbrakes did not actuate.', tone:'cream'},
  {date:'April 12, 2026', title:'Full-Deployment Flight', text:'5,597 ft with full deployment; reported apogee was 4.6% lower than baseline.', tone:'sage'},
  {date:'May 2026', title:'Team Recognition', text:'Best Senior Design Project, GW Department of Mechanical & Aerospace Engineering.', tone:'cream'},
];
---
<section id="development-flight" class="rocket-section rocket-development-flight" aria-labelledby="development-flight-heading">
  <div class="rocket-section-heading">
    <p class="eyebrow">PROJECT DEVELOPMENT &amp; FLIGHT</p>
    <h2 id="development-flight-heading">from concept to flight.</h2>
  </div>

  <div class="rocket-result-grid" aria-label="Flight metrics">
    <div><p>BASELINE FLIGHT</p><time datetime="2026-04-11">April 11, 2026</time><strong>5,867 <small>ft</small></strong></div>
    <div><p>FULL-DEPLOYMENT FLIGHT</p><time datetime="2026-04-12">April 12, 2026</time><strong>5,597 <small>ft</small></strong></div>
    <div class="rocket-result-delta"><p>REPORTED COMPARISON</p><strong>4.6% <small>lower apogee</small></strong></div>
  </div>
  <p class="rocket-result-caveat">Full airbrake deployment was demonstrated in flight. Predictive feedback control was evaluated in simulation and was not validated in flight.</p>

  <div class="development-details">
    <div class="development-photos">
      <TechnicalFigure src="/images/projects/rocket-airbrake/media/rocket-team-launchpad.webp" alt="Four-person project team beside the assembled rocket at the launch pad; the rocket extends beyond the top edge of the photograph." caption="Four-person capstone team · launch pad" width={781} height={1004} className="development-photo-team"/>
      <TechnicalFigure src="/images/projects/rocket-airbrake/media/rocket-in-flight.webp" alt="Rocket ascending under motor thrust against a blue sky." caption="Rocket during powered ascent." width={174} height={662} className="development-photo-flight"/>
    </div>
    <ol class="development-timeline" aria-label="Project development timeline">
      {milestones.map(milestone => <li class={`tone-${milestone.tone}`}>
        <time>{milestone.date}</time><span class="development-dot" aria-hidden="true"></span>
        <div><h3>{milestone.title}</h3><p>{milestone.text}</p></div>
      </li>)}
    </ol>
  </div>

  <div id="recognition" class="development-recognition">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4"/></svg>
    <div><strong>Best Senior Design Project</strong><p>George Washington University · Mechanical &amp; Aerospace Engineering · 2026</p></div>
    <div class="development-recognition-links">
      <a href="https://engineering.gwu.edu/undergraduates-celebrate-academic-achievements-and-professional-commitment" target="_blank" rel="noopener noreferrer">GW announcement <span aria-hidden="true">↗</span></a>
      <a href="https://www.linkedin.com/posts/gwengineering-aerospaceengineering-studentinnovation-ugcPost-7449460353106694144-ZQYm/" target="_blank" rel="noopener noreferrer">GW Engineering feature <span aria-hidden="true">↗</span></a>
      <a href={url('/about/#honors-senior-design')}>About the recognition <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .development-details { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.06fr); gap:clamp(28px,5vw,58px); align-items:start; margin-top:var(--process-intro-gap); }
  .development-photos { display:grid; grid-template-columns:minmax(0,1fr) minmax(74px,.34fr); align-items:start; gap:12px; }
  .development-photos :global(.technical-figure-frame) { display:flex; height:clamp(320px,35vw,430px); align-items:center; justify-content:center; padding:0; overflow:hidden; border:0; border-radius:10px; background:transparent; }
  .development-photos :global(.technical-figure-frame img) { width:auto; height:100%; max-width:100%; max-height:none; border-radius:10px; object-fit:contain; }
  .development-photos :global(figcaption) { padding-top:8px; }
  .development-timeline { --date-width:112px; position:relative; display:grid; grid-template-columns:var(--date-width) 18px minmax(0,1fr); margin:0; padding:0; list-style:none; }
  .development-timeline::before { position:absolute; top:8px; bottom:8px; left:calc(var(--date-width) + 9px); width:1px; background:#d9dfdd; content:''; }
  .development-timeline li { display:grid; grid-column:1 / -1; grid-template-columns:subgrid; align-items:start; padding:0 0 10px; }
  .development-timeline li:last-child { padding-bottom:0; }
  .development-timeline time { padding:1px 12px 0 0; color:#66716f; font-size:9px; line-height:1.45; text-align:right; }
  .development-dot { z-index:1; width:8px; height:8px; margin:4px auto 0; border:1px solid #b9c9d8; border-radius:50%; background:#dce7ef; }
  .tone-coral .development-dot { border-color:#c89c91; background:#f1e4e1; }.tone-sage .development-dot { border-color:#93aa95; background:#e7eee7; }.tone-lavender .development-dot { border-color:#c8bad3; background:#f1edf5; }.tone-cream .development-dot { border-color:#d1c0a7; background:#f5eee3; }
  .development-timeline h3 { margin:0; font-size:13px; line-height:1.35; }.development-timeline p { margin:2px 0 0; color:#555b55; font-size:10px; line-height:1.45; }
  .development-recognition { display:grid; grid-template-columns:24px minmax(0,1fr) auto; align-items:center; gap:10px 13px; margin-top:var(--process-outro-gap); padding:16px 0; border-block:1px solid var(--border); }
  .development-recognition svg { width:20px; height:20px; fill:none; stroke:#80745f; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.4; }.development-recognition strong { font-size:14px; font-weight:550; }.development-recognition p { margin:3px 0 0; color:var(--muted); font-size:11px; }
  .development-recognition-links { display:flex; flex-wrap:wrap; justify-content:end; gap:8px 14px; }.development-recognition-links a { color:#365a7c; font-size:11px; text-decoration:underline; text-decoration-color:#b9c8d6; text-underline-offset:3px; }
  @media(max-width:800px) { .development-details { grid-template-columns:1fr; }.development-photos { max-width:540px; }.development-recognition { grid-template-columns:24px minmax(0,1fr); }.development-recognition-links { grid-column:2; justify-content:start; } }
  @media(max-width:500px) { .development-photos { grid-template-columns:1fr; max-width:300px; }.development-photos :global(.technical-figure-frame) { height:270px; }.development-timeline { --date-width:0px; grid-template-columns:18px minmax(0,1fr); }.development-timeline::before { left:9px; }.development-timeline li { row-gap:1px; padding-bottom:12px; }.development-timeline time { grid-column:2; padding:0 0 0 11px; text-align:left; }.development-dot { grid-column:1; grid-row:1 / span 2; }.development-timeline li>div { grid-column:2; padding-left:11px; }.development-recognition-links { display:grid; gap:6px; } }
</style>
