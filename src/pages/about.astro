---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessCard from '../components/BusinessCard.astro';
import AboutContents from '../components/AboutContents.astro';
import ResearchProcess from '../components/ResearchProcess.astro';
import BentoGrid from '../components/BentoGrid.astro';
import ExpertiseGrid from '../components/ExpertiseGrid.astro';
import ToolkitGrid from '../components/ToolkitGrid.astro';
import IndustriesGrid from '../components/IndustriesGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EducationCard from '../components/EducationCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import {education} from '../data/profile';
import {resumeAvailable} from '../data/site';
import {url} from '../lib/paths';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="About">
<div class="wrap">
<header class="page-header">
<p class="eyebrow">the person behind the projects</p>
<h1>a little<br/>
<span>about me.</span>
</h1>
</header>
<section class="about-intro">
<div class="bio" data-reveal>
<p class="lead">I've always been curious about how things work—and even more interested in finding ways to make them work better.</p>
<p>I'm currently pursuing my M.S. in Mechanical Engineering at Columbia University. My experience has taken me from precision optical metrology at Apple and manufacturing at Medtronic to robotics, embedded systems, and experimental engineering research.</p>
<p>What I enjoy most is connecting technical ideas with real-world applications. Whether I'm developing hardware, analyzing data, or improving a manufacturing process, I like working through complex problems and turning them into practical solutions.</p>
<p>I'm equally interested in the people and planning behind successful engineering. I enjoy collaborating across disciplines, taking ownership of projects, and bringing teams together to move an idea from concept to implementation. I'm particularly drawn to opportunities in hardware, manufacturing, robotics, and engineering project or program management.</p>
<div class="bio-signature">Shota Kakiuchi <span>機械工学 / MECHANICAL ENGINEERING</span>
</div>
</div>
<BusinessCard/>
</section>
<AboutContents/>
<section id="education" class="section">
<SectionHeading eyebrow="01 / education" title="a foundation for what's next."/>
<div class="education-grid">{education.map(item=>
<EducationCard item={item}/>)}</div>
</section>
<section id="experience" class="section">
<SectionHeading eyebrow="02 / experience" title="learning by building." description="Across hardware, manufacturing, research, and consulting."/>
<ExperienceTimeline/>
</section>
<ResearchProcess/>
<ExpertiseGrid/>
<ToolkitGrid/>
<IndustriesGrid/>
<details class="overview-disclosure"><summary>at a glance <span aria-hidden="true">+</span></summary><div class="overview-content"><BentoGrid/></div></details>
{resumeAvailable && <section class="resume-strip surface" data-reveal>
  <div><p class="eyebrow">the full picture</p><h2>experience, on paper.</h2></div>
  <a class="button primary" href={url('/resume/')}>view resume <Icon name="download"/></a>
</section>}
</div>
</BaseLayout>
