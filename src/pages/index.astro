---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HomeGlance from '../components/HomeGlance.astro';
import Icon from '../components/Icon.astro';
import {url} from '../lib/paths';
const projects=(await getCollection('projects',({data})=>data.status==='published' && data.featured !== undefined)).sort((a,b)=>(a.data.featured ?? 99)-(b.data.featured ?? 99)).slice(0,3);
---
<BaseLayout>
  <Hero/>
  <span id="overview" aria-hidden="true"></span>
  <section class="selected-work wrap" id="work" aria-labelledby="work-heading">
    <div class="section-heading-row" data-reveal>
      <div><p class="eyebrow">selected work</p><h2 id="work-heading">ideas into <span class="marker-highlight marker-sage">systems.</span></h2></div>
      <a class="text-link" href={url('/projects/')}>all projects <Icon name="arrow"/></a>
    </div>
    <div class="project-grid selected-grid">{projects.map(project=><ProjectCard project={project}/>)}</div>
  </section>
  <HomeGlance/>
  <section class="home-outro wrap" data-reveal>
    <p class="eyebrow">curiosity, from idea to implementation</p>
    <h2>there's always more<br/>to figure out.</h2>
    <p>i work at the intersection of hardware, software, and manufacturing — building technologies and making complex systems work better.</p>
    <a class="text-link" href={url('/contact/')}>let's connect <Icon name="arrow"/></a>
  </section>
</BaseLayout>
