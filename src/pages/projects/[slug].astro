---
import {getCollection,render} from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>data.status==='published')).map(project=>({params:{slug:project.id},props:{project}}));}
const {project}=Astro.props;const {Content,headings}=await render(project);
---
<ProjectLayout project={project} headings={headings}>
<Content/>
</ProjectLayout>
